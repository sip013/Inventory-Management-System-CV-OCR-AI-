class InventorySystem:
    def __init__(self):
        self.conn = sqlite3.connect(DATABASE_NAME)
        self.cursor = self.conn.cursor()
        self._initialize_database()
        pytesseract.pytesseract.tesseract_cmd = r'C:\Program Files (x86)\Tesseract-OCR\tesseract.exe'

    def _initialize_database(self):
        """Create database with advanced schema"""
        self.cursor.execute("""
        CREATE TABLE IF NOT EXISTS items (
            item_id INTEGER PRIMARY KEY AUTOINCREMENT,
            unique_id TEXT UNIQUE,
            name TEXT NOT NULL,
            normalized_name TEXT NOT NULL,
            category TEXT,
            normalized_category TEXT,
            count INTEGER DEFAULT 1,
            quantity_value REAL,
            quantity_unit TEXT,
            expiry_date TEXT,
            freshness_state TEXT CHECK(freshness_state IN ('fresh', 'expiring soon', 'stale', 'expired', 'rotten')),
            detection_confidence REAL,
            last_updated TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        """)
        self.cursor.execute("""
        CREATE TABLE IF NOT EXISTS item_images (
            image_id INTEGER PRIMARY KEY AUTOINCREMENT,
            item_id INTEGER,
            image_data BLOB,
            FOREIGN KEY(item_id) REFERENCES items(item_id)
        )
        """)
        self.conn.commit()

    def _generate_unique_id(self, name):
        """Generate unique ID for each item"""
        timestamp = datetime.now().strftime("%Y%m%d%H%M%S%f")
        return f"{name.lower().replace(' ', '')}{timestamp}"

    def _preprocess_image(self, image_data):
        """Enhance image for better OCR and analysis"""
        try:
            img = Image.open(io.BytesIO(image_data))
            img = np.array(img)
            
            # Convert to grayscale if not already
            if len(img.shape) == 3:
                gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            else:
                gray = img
                
            # Denoise and enhance
            denoised = cv2.fastNlMeansDenoising(gray, None, 10, 7, 21)
            clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8,8))
            enhanced = clahe.apply(denoised)
            _, threshold = cv2.threshold(enhanced, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
            
            # Additional sharpening
            kernel = np.array([[-1,-1,-1], [-1,9,-1], [-1,-1,-1]])
            sharpened = cv2.filter2D(threshold, -1, kernel)
            
            return sharpened
        except Exception as e:
            print(f"Image preprocessing error: {e}")
            return None

    def _extract_packaging_info(self, image_data):
        """Extract quantity and expiry using enhanced OCR"""
        try:
            processed_img = self._preprocess_image(image_data)
            if processed_img is None:
                return None, None, None
                
            text = pytesseract.image_to_string(processed_img, config=TESSERACT_CONFIG)
            
            # Quantity extraction
            quantity, unit = None, None
            quantity_patterns = [
                (r'(\d+\.?\d*)\s?(g|grams?)\b', 'g'),
                (r'(\d+\.?\d*)\s?(kg|kilos?)\b', 'kg'),
                (r'(\d+\.?\d*)\s?(ml|milliliters?)\b', 'ml'),
                (r'(\d+\.?\d*)\s?(l|liters?)\b', 'l'),
                (r'net\s*(?:wt|weight)[:.]?\s*(\d+\.?\d*)\s?(g|kg|ml|l)\b', None),
                (r'(\d+)\s?(pcs|pieces?|units?)\b', 'unit')
            ]
            
            for pattern, default_unit in quantity_patterns:
                if match := re.search(pattern, text, re.IGNORECASE):
                    quantity = float(match.group(1))
                    unit = match.group(2).lower() if len(match.groups()) > 1 else default_unit
                    unit = {'gram': 'g', 'grams': 'g', 'kilo': 'kg', 'kilos': 'kg',
                           'liter': 'l', 'liters': 'l', 'milliliter': 'ml', 
                           'milliliters': 'ml', 'piece': 'unit', 'pieces': 'unit',
                           'pcs': 'unit'}.get(unit, unit)
                    break
            
            # Expiry date extraction
            expiry_date = None
            date_patterns = [
                r'expir(?:y|ation)[:.\s-]*(\d{2}[/-]\d{2}[/-]\d{2,4})',
                r'use\s*by[:.\s-]*(\d{2}[/-]\d{2}[/-]\d{2,4})',
                r'best\s*before[:.\s-]*(\d{2}[/-]\d{2}[/-]\d{2,4})',
                r'(\d{2}[/-]\d{2}[/-]\d{2,4})'
            ]
            
            for pattern in date_patterns:
                if match := re.search(pattern, text, re.IGNORECASE):
                    expiry_date = match.group(1).replace('-', '/')
                    try:
                        # Handle 2-digit year
                        if len(expiry_date.split('/')[-1]) == 2:
                            expiry_date = expiry_date[:-2] + '20' + expiry_date[-2:]
                        expiry_date = datetime.strptime(expiry_date, '%d/%m/%Y').strftime('%Y-%m-%d')
                        break
                    except ValueError:
                        continue
            
            return quantity, unit, expiry_date
        except Exception as e:
            print(f"Packaging info extraction error: {e}")
            return None, None, None

    def _analyze_freshness(self, image_data, expiry_date=None):
        """Enhanced freshness analysis with specific rotten food detection"""
        try:
            # First check expiry date if available
            if expiry_date:
                try:
                    expiry = datetime.strptime(expiry_date, '%Y-%m-%d')
                    days_remaining = (expiry - datetime.now()).days
                    if days_remaining < 0:
                        return "expired"
                    elif days_remaining <= 3:
                        return "expiring soon"
                except ValueError:
                    pass

            # Enhanced prompt for visual freshness analysis
            prompt = """Carefully analyze this food item for freshness. Consider:
            - Color changes (browning, dark spots)
            - Texture (mushiness, wrinkles)
            - Visible mold or fungus
            - Any signs of decay or rot
            - Packaging damage (if visible)
            
            For fruits/vegetables specifically check for:
            - Bruises or soft spots
            - Mold growth
            - Unnatural discoloration
            - Shriveling or drying
            
            Return ONLY one of these exact terms:
            - 'fresh' if perfectly good
            - 'expiring soon' if slightly aged but edible
            - 'stale' if past prime but not rotten
            - 'rotten' if visibly spoiled or moldy
            - 'expired' if past expiry date"""
            
            retries = 3
            for attempt in range(retries):
                try:
                    response = vision_model.generate_content([{
                        "mime_type": "image/jpeg",
                        "data": image_data
                    }, {
                        "text": prompt
                    }], request_options={"timeout": 10})
                    
                    # Clean and validate response
                    state = response.text.strip().lower()
                    valid_states = ['fresh', 'expiring soon', 'stale', 'rotten', 'expired']
                    
                    if state in valid_states:
                        return state
                    
                    # Fallback analysis if response isn't valid
                    if any(keyword in response.text.lower() 
                           for keyword in ['mold', 'rot', 'spoiled', 'decay', 'bad']):
                        return "rotten"
                    if any(keyword in response.text.lower()
                          for keyword in ['old', 'aged', 'expiring']):
                        return "expiring soon"
                    
                    return "stale"  # Default to stale if uncertain
                
                except Exception as e:
                    if attempt == retries - 1:
                        print(f"Freshness analysis failed after {retries} attempts: {e}")
                        return "stale"
                    time.sleep(1)  # Wait before retrying
        
        except Exception as e:
            print(f"Freshness analysis error: {e}")
            return "stale"  # Default to stale if analysis fails

    def detect_objects(self, image_data):
        """Detect multiple objects in image with counts and details"""
        prompt = """Analyze this image and identify all distinct food/grocery items with:
        - Exact name (be specific about brand/variety if visible)
        - Count of each distinct item
        - Category (dairy, vegetable, fruit, meat, grain, canned, frozen, etc.)
        
        Important rules:
        - If multiple identical items, count them
        - Group similar items together
        - Be specific when possible (e.g., "Red Delicious Apple" instead of just "Apple")
        - If packaging is visible, include brand names
        
        Return as valid JSON format ONLY with this exact structure:
        {
            "items": [
                {
                    "name": "exact item name",
                    "count": number,
                    "category": "specific category"
                }
            ]
        }"""
        
        retries = 3
        for attempt in range(retries):
            try:
                response = vision_model.generate_content([{
                    "mime_type": "image/jpeg", 
                    "data": image_data
                }, {
                    "text": prompt
                }], request_options={"timeout": 15})
                
                # Clean response text
                response_text = response.text.strip()
                if response_text.startswith('json'):
                    response_text = response_text[7:-3].strip()
                elif response_text.startswith(''):
                    response_text = response_text[3:-3].strip()
                
                # Parse and validate
                data = json.loads(response_text)
                if not isinstance(data, dict) or "items" not in data:
                    raise ValueError("Invalid response format")
                
                # Validate each item
                valid_items = []
                for item in data["items"]:
                    if all(key in item for key in ['name', 'count', 'category']):
                        valid_items.append({
                            'name': item['name'].strip(),
                            'count': int(item['count']),
                            'category': item['category'].strip().lower()
                        })
                
                if not valid_items:
                    raise ValueError("No valid items found")
                
                return valid_items
                
            except json.JSONDecodeError:
                # Try to extract JSON from malformed response
                try:
                    json_str = re.search(r'\{.*\}', response_text, re.DOTALL)
                    if json_str:
                        data = json.loads(json_str.group(0))
                        if "items" in data:
                            return data["items"]
                except:
                    pass
                
                if attempt == retries - 1:
                    print("Failed to get valid JSON response after retries")
                    return []
                time.sleep(1)
                
            except Exception as e:
                print(f"Detection error (attempt {attempt+1}): {e}")
                if attempt == retries - 1:
                    return []
                time.sleep(1)

    def process_inventory(self, front_image_data, back_image_data=None):
        """Full processing pipeline for inventory items"""
        try:
            detected_items = self.detect_objects(front_image_data)
            if not detected_items:
                print("No items detected")
                return []
            
            packaging_info = {}
            if back_image_data:
                quantity, unit, expiry_date = self._extract_packaging_info(back_image_data)
                packaging_info = {
                    'quantity': quantity,
                    'unit': unit,
                    'expiry_date': expiry_date
                }
            
            results = []
            for item in detected_items:
                unique_id = self._generate_unique_id(item['name'])
                quantity = packaging_info.get('quantity', item.get('count', 1))
                unit = packaging_info.get('unit', 'unit')
                expiry_date = packaging_info.get('expiry_date')
                freshness = self._analyze_freshness(front_image_data, expiry_date)
                
                # Store item in database
                item_id = self._store_item(
                    unique_id=unique_id,
                    name=item['name'],
                    category=item.get('category', 'unknown'),
                    count=item['count'],
                    quantity_value=quantity,
                    quantity_unit=unit,
                    expiry_date=expiry_date,
                    freshness_state=freshness,
                    image_data=front_image_data
                )
                
                if item_id:
                    results.append({
                        'unique_id': unique_id,
                        'name': item['name'],
                        'count': item['count'],
                        'quantity': f"{quantity} {unit}" if quantity else "N/A",
                        'expiry_date': expiry_date,
                        'freshness': freshness
                    })
                else:
                    print(f"Failed to store item: {item['name']}")
            
            return results
        
        except Exception as e:
            print(f"Processing error: {e}")
            return []

    def _normalize_name(self, name):
        """Advanced name normalization"""
        if not name:
            return ""
        # Convert to lowercase, remove plurals, and strip special chars
        name = name.lower().strip()
        name = re.sub(r'\b(the|a|an)\b', '', name)  # Remove articles
        name = re.sub(r's$', '', name)  # Remove simple plurals
        name = re.sub(r'[^a-z0-9]', '', name)  # Remove special chars
        return name

    def _find_matching_item(self, name, category, freshness_state):
        """Find matching item with fuzzy matching"""
        try:
            normalized_name = self._normalize_name(name)
            normalized_category = self._normalize_name(category) if category else None

            # First try exact match
            self.cursor.execute("""
            SELECT item_id, count, quantity_value, quantity_unit 
            FROM items 
            WHERE normalized_name = ? 
            AND (? IS NULL OR normalized_category = ?)
            AND freshness_state = ?
            """, (normalized_name, normalized_category, normalized_category, freshness_state))

            exact_match = self.cursor.fetchone()
            if exact_match:
                return exact_match

            # Fallback to fuzzy matching if no exact match
            self.cursor.execute("""
            SELECT item_id, name, count, quantity_value, quantity_unit 
            FROM items 
            WHERE freshness_state = ?
            """, (freshness_state,))

            best_match = None
            best_score = 0
            threshold = 80  # Minimum similarity score

            for item in self.cursor.fetchall():
                item_id, existing_name, count, qty_value, qty_unit = item
                name_score = fuzz.ratio(self._normalize_name(name), self._normalize_name(existing_name))
                
                if name_score > best_score and name_score >= threshold:
                    best_score = name_score
                    best_match = (item_id, count, qty_value, qty_unit)

            return best_match

        except sqlite3.Error as e:
            print(f"Database query error: {e}")
            return None

    def _store_item(self, unique_id, name, category, count, quantity_value, quantity_unit, 
                   expiry_date, freshness_state, image_data=None):
        """Completely fixed storage with proper merging and error handling"""
        try:
            # Normalize all identifiers
            normalized_name = self._normalize_name(name)
            normalized_category = self._normalize_name(category) if category else None
            
            # Check for existing matches
            matching_item = self._find_matching_item(name, category, freshness_state)
            
            if matching_item:
                item_id, existing_count, existing_qty_value, existing_qty_unit = matching_item
                
                # Update existing record
                new_count = existing_count + count
                
                # Convert units if needed before adding
                if existing_qty_unit != quantity_unit:
                    converted_value = self._convert_units(quantity_value, quantity_unit, existing_qty_unit)
                    if converted_value is not None:
                        new_qty_value = existing_qty_value + converted_value
                    else:
                        new_qty_value = quantity_value
                        quantity_unit = existing_qty_unit
                else:
                    new_qty_value = existing_qty_value + quantity_value
                
                self.cursor.execute("""
                UPDATE items 
                SET count = ?,
                    quantity_value = ?,
                    last_updated = CURRENT_TIMESTAMP
                WHERE item_id = ?""",
                (new_count, new_qty_value, item_id))
                
                print(f"↻ Merged: {name} → Total: {new_count}, Qty: {new_qty_value}{existing_qty_unit}")
                
                # Store image if provided
                if image_data:
                    self._store_item_image(item_id, image_data)
                    
                self.conn.commit()
                return item_id
            else:
                # Insert new record with normalized names
                self.cursor.execute("""
                INSERT INTO items (
                    unique_id, name, normalized_name, 
                    category, normalized_category,
                    count, quantity_value, quantity_unit, 
                    expiry_date, freshness_state
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                (unique_id, name, normalized_name,
                 category, normalized_category,
                 count, quantity_value, quantity_unit,
                 expiry_date, freshness_state))
                
                item_id = self.cursor.lastrowid
                print(f"✓ New item: {name} ({count} @ {quantity_value}{quantity_unit})")
                
                # Store image if provided
                if image_data and item_id:
                    self._store_item_image(item_id, image_data)
                
                self.conn.commit()
                return item_id
            
        except sqlite3.Error as e:
            print(f"Database error: {e}")
            self.conn.rollback()
            return None
        except Exception as e:
            print(f"Unexpected error: {e}")
            self.conn.rollback()
            return None

    def _store_item_image(self, item_id, image_data):
        """Store item image in database"""
        try:
            self.cursor.execute("""
            INSERT INTO item_images (item_id, image_data)
            VALUES (?, ?)""", (item_id, image_data))
            return True
        except sqlite3.Error as e:
            print(f"Failed to store image: {e}")
            return False

    def _convert_units(self, value, from_unit, to_unit):
        """Handle unit conversions between compatible units"""
        if from_unit == to_unit:
            return value
            
        conversions = {
            ('g', 'kg'): lambda x: x / 1000,
            ('kg', 'g'): lambda x: x * 1000,
            ('ml', 'l'): lambda x: x / 1000,
            ('l', 'ml'): lambda x: x * 1000,
            ('unit', 'pcs'): lambda x: x,
            ('pcs', 'unit'): lambda x: x
        }
        
        converter = conversions.get((from_unit, to_unit))
        return converter(value) if converter else None
    
    def capture_images(self):
        """Interactive webcam capture with live stream"""
        cap = cv2.VideoCapture(2)  # Changed to index 2 as per your solution
        if not cap.isOpened():
            print("Error: Could not open webcam")
            return None, None
        
        front_image, back_image = None, None
        try:
            while True:
                ret, frame = cap.read()
                if not ret:
                    print("Error: Could not read frame")
                    break
                
                # Display live stream with instructions
                cv2.imshow("Press 'F' for Front, 'B' for Back, 'Q' to Quit", frame)
                key = cv2.waitKey(1) & 0xFF
                
                if key == ord('f'):
                    _, buffer = cv2.imencode('.jpg', frame)
                    front_image = buffer.tobytes()
                    print("Front image captured")
                elif key == ord('b'):
                    _, buffer = cv2.imencode('.jpg', frame)
                    back_image = buffer.tobytes()
                    print("Back image captured")
                elif key == ord('q'):
                    break
        finally:
            cap.release()
            cv2.destroyAllWindows()
        
        return front_image, back_image

    def run(self):
        """Main application loop"""
        while True:
            print("\n=== Inventory Management ===")
            print("1. Capture and process items")
            print("2. View inventory")
            print("3. Exit")
            
            choice = input("Select option: ").strip()
            
            if choice == "1":
                print("\nCapture front of item (press 'F' when ready)")
                front, back = self.capture_images()
                if front:
                    print("\nProcessing item...")
                    results = self.process_inventory(front, back)
                    if results:
                        print("\nProcessed Items:")
                        for item in results:
                            print(f"\n{item['count']}x {item['name']}")
                            print(f"Quantity: {item['quantity']}")
                            print(f"Expiry: {item['expiry_date'] or 'N/A'}")
                            print(f"Freshness: {item['freshness']}")
                            print(f"ID: {item['unique_id']}")
                    else:
                        print("No items were processed")
            
            elif choice == "2":
                self.cursor.execute("""
                SELECT unique_id, name, count, quantity_value, 
                       quantity_unit, expiry_date, freshness_state 
                FROM items ORDER BY freshness_state, expiry_date
                """)
                
                items = self.cursor.fetchall()
                if not items:
                    print("\nInventory is empty")
                    continue
                    
                print("\nCurrent Inventory:")
                for item in items:
                    print(f"\nID: {item[0]}")
                    print(f"Name: {item[1]} (x{item[2]})")
                    print(f"Quantity: {item[3]} {item[4]}")
                    print(f"Expiry: {item[5] or 'N/A'}")
                    print(f"Freshness: {item[6]}")
            
            elif choice == "3":
                print("Exiting...")
                break
            
            else:
                print("Invalid option")

        self.conn.close()

if __name__ == "__main__":
    system = InventorySystem()
    system.run()
